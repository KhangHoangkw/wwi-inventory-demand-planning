table 'Invoice Line'
	lineageTag: c93fad67-971c-49ed-bcf5-fa6022d63fd1

	measure Revenue = SUM('Invoice Line'[revenue_excl_tax])
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: cd9a9724-d6f4-4b3d-8875-d4370d693d23

	measure 'Gross Profit' = SUM('Invoice Line'[line_profit])
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 673e8f26-df6e-4ba6-8de3-e3b47d7b981b

	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Revenue])
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 5ce75018-130d-46b3-8e51-b7d21aaf9ee9

	measure 'On-Time Delivery %' = DIVIDE(CALCULATE(DISTINCTCOUNT('Invoice Line'[invoice_id]), 'Invoice Line'[is_on_time] = 1), CALCULATE(DISTINCTCOUNT('Invoice Line'[invoice_id]), NOT ISBLANK('Invoice Line'[is_on_time])))
		formatString: 0.0%
		displayFolder: Service
		lineageTag: d4120136-ee60-4ffe-ad00-38169fd3009d

	measure 'Avg Days Order to Delivery' = AVERAGE('Invoice Line'[days_order_to_delivery])
		formatString: 0.0
		displayFolder: Service
		lineageTag: c0036844-c2a1-4151-8a27-2b06a44de707

	/// Revenue growth vs the same dates one year earlier, capped at the last invoice date so the partial year 2016 (Jan-May) is compared with Jan-May 2015
	measure 'Revenue YoY % (same period)' =
			VAR _maxDate = CALCULATE ( MAX ( 'Invoice Line'[invoice_date] ), REMOVEFILTERS () )
			VAR _dates = FILTER ( VALUES ( 'Date'[date] ), 'Date'[date] <= _maxDate )
			VAR _cur = CALCULATE ( [Revenue], _dates )
			VAR _py = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( _dates ) )
			RETURN IF ( NOT ISBLANK ( _py ), DIVIDE ( _cur - _py, _py ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Sales
		lineageTag: 8a2b67c8-6f92-4a34-818c-2649c8941802

