table Simulation
	lineageTag: 70415094-4d17-4ee5-bc98-6fbf791c8bb8

	measure 'Sim Fill Rate' = DIVIDE(SUM(Simulation[filled_qty]), SUM(Simulation[demand_qty]))
		formatString: 0.00%
		displayFolder: Simulation
		lineageTag: 756d2c0f-afa7-4ebe-b9b5-1a1d792b58a2

	measure 'Sim Avg Inventory Value' = SUMX(VALUES('Stock Item'[stock_item_id]), CALCULATE(AVERAGE(Simulation[on_hand_end])) * CALCULATE(MAX('Stock Item'[last_cost_price])))
		formatString: \$#,0
		displayFolder: Simulation
		lineageTag: ec9e0add-854b-4087-aeab-e747b3136b7e

	measure 'Sim COGS' = SUMX(VALUES('Stock Item'[stock_item_id]), CALCULATE(SUM(Simulation[filled_qty])) * CALCULATE(MAX('Stock Item'[last_cost_price])))
		formatString: \$#,0
		displayFolder: Simulation
		lineageTag: d7546a84-09f0-47f3-b022-2e5e7880da47

	measure 'Sim Inventory Turns' = DIVIDE([Sim COGS], [Sim Avg Inventory Value])
		formatString: 0.0
		displayFolder: Simulation
		lineageTag: 723cf434-263f-4338-a643-233c099608e3

	measure 'Sim Purchase Orders' = CALCULATE(COUNTROWS(Simulation), Simulation[order_qty] > 0)
		formatString: #,0
		displayFolder: Simulation
		lineageTag: a9f25ea0-5bd9-430a-8095-97a4780b3f60

	measure 'Target Gap' = VAR t = MAX(Scenario[service_level]) RETURN IF(ISBLANK(t) || HASONEVALUE(Scenario[scenario_id]) = FALSE(), BLANK(), [Sim Fill Rate] - t)
		formatString: +0.00%;-0.00%
		displayFolder: Simulation
		lineageTag: 56c61272-b53d-476c-bb54-9f992af840f8

	column run_type
		dataType: string
