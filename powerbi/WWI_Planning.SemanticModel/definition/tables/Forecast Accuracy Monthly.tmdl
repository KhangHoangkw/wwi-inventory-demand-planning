/// WAPE and bias by model and month, with rank in month (gold.vw_forecast_accuracy_monthly)
table 'Forecast Accuracy Monthly'
	lineageTag: 5a63b799-8984-4832-a8cc-edb4f5f896f9

	column month_start
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: 720222d7-0e85-43fd-9ed2-aaeb99161780
		sourceColumn: month_start

	column model
		dataType: string
		lineageTag: 9a55b5bb-1621-46ad-864a-aae7f1ebdcce
		sourceColumn: model

	column wape
		dataType: double
		formatString: 0.0%
		lineageTag: 175c0837-9fb2-47ce-88b0-0b593d87af2d
		summarizeBy: none
		sourceColumn: wape

	column bias
		dataType: double
		formatString: 0.0%
		lineageTag: 342a2e3c-fc01-4dac-97be-b1de5d728d8b
		summarizeBy: none
		sourceColumn: bias

	column window_
		dataType: string
		lineageTag: fa119dd4-d7ca-4e2d-8f0d-49895ee343fc
		sourceColumn: window_

	column rank_in_month
		dataType: int64
		lineageTag: d731c9b4-92b0-4f31-9435-a9645413cad9
		summarizeBy: none
		sourceColumn: rank_in_month

	partition 'Forecast Accuracy Monthly' = m
		mode: import
		source = let Source = Sql.Database("localhost", "WWI_Analytics"), T = Source{[Schema="gold",Item="vw_forecast_accuracy_monthly"]}[Data] in T

