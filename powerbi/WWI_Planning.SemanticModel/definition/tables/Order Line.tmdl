table 'Order Line'
	lineageTag: c051237c-7409-41d9-aa01-2e9f07ee88a9

	measure 'Units Ordered' = SUM('Order Line'[quantity])
		formatString: #,0
		displayFolder: Demand
		lineageTag: 3febb879-f18c-4319-a48a-483369367877

	measure 'Units Picked' = SUM('Order Line'[picked_quantity])
		formatString: #,0
		displayFolder: Demand
		lineageTag: 099abe4b-e1a2-48a3-b4d8-7f9872973faa

	measure 'Unit Fill Rate' = DIVIDE([Units Picked], [Units Ordered])
		formatString: 0.0%
		displayFolder: Service
		lineageTag: 895fdb62-1c21-42e8-b412-a65fe61afee2

	measure 'Backorder Unit Share' = DIVIDE(CALCULATE([Units Ordered], 'Order Line'[is_backorder_line] = 1), [Units Ordered])
		formatString: 0.0%
		displayFolder: Service
		lineageTag: 95b165fc-b701-48ee-8244-d9936ce2ef45

	measure Orders = DISTINCTCOUNT('Order Line'[order_id])
		formatString: #,0
		displayFolder: Demand
		lineageTag: 7092d8f3-331f-4d47-931c-4ca4e1cd46d7

	/// Units ordered vs the same dates one year earlier, capped at the last order date
	measure 'Units YoY % (same period)' =
			VAR _maxDate = CALCULATE ( MAX ( 'Order Line'[order_date] ), REMOVEFILTERS () )
			VAR _dates = FILTER ( VALUES ( 'Date'[date] ), 'Date'[date] <= _maxDate )
			VAR _cur = CALCULATE ( [Units Ordered], _dates )
			VAR _py = CALCULATE ( [Units Ordered], SAMEPERIODLASTYEAR ( _dates ) )
			RETURN IF ( NOT ISBLANK ( _py ), DIVIDE ( _cur - _py, _py ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Demand
		lineageTag: b235f274-8b0b-405b-9f19-ee29d20e754b

