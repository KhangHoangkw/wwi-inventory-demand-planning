table 'Policy Parameters'
	lineageTag: 763c8ac0-21b0-47f3-b43d-46e5819b8548

	measure 'Safety Stock What-if (units)' = VAR z = NORM.S.INV([Target SL Value]) RETURN DIVIDE(SUMX('Policy Parameters', z * 'Policy Parameters'[sigma_lt]), DISTINCTCOUNT('Policy Parameters'[month_start]))
		formatString: #,0
		displayFolder: What-if
		lineageTag: 2ab59d12-6c9e-4e3e-84b6-4405083037f3

	measure 'Safety Stock What-if (value)' = VAR z = NORM.S.INV([Target SL Value]) RETURN DIVIDE(SUMX('Policy Parameters', z * 'Policy Parameters'[sigma_lt] * RELATED('Stock Item'[last_cost_price])), DISTINCTCOUNT('Policy Parameters'[month_start]))
		formatString: \$#,0
		displayFolder: What-if
		lineageTag: ef842e7e-07f8-483b-9a67-ea041bf86a55

